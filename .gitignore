# ==============================================================================
# SECURE VAULT - GITIGNORE
# Files and folders excluded from Git version control (will not commit or push)
# ==============================================================================

# ------------------------------------------------------------------------------
# Security, Keys & Secrets (CRITICAL: Never commit credentials or keys)
# ------------------------------------------------------------------------------
*.keystore
*.jks
*.p12
*.pem
*.key
*.cer
*.crt
key.properties
release.keystore
debug.keystore
private_key.pepk
google-services.json
GoogleService-Info.plist
.env
.env.*
secrets/
credentials.json

# ------------------------------------------------------------------------------
# Vault Data & Local Databases (Sensitive user/test data)
# ------------------------------------------------------------------------------
vault.enc
*.enc
test_storage/
*.db
*.sqlite
*.sqlite3
*.tmp
*.bak

# ------------------------------------------------------------------------------
# Flutter / Dart / Pub Dependencies & Build
# ------------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
/build/
coverage/
**/doc/api/
.widget_preview/

# ------------------------------------------------------------------------------
# Symbolication & Obfuscation
# ------------------------------------------------------------------------------
app.*.symbols
app.*.map.json

# ------------------------------------------------------------------------------
# Android Build Outputs & Local Configs
# ------------------------------------------------------------------------------
android/.gradle/
**/.gradle/
android/local.properties
android/captures/
android/app/debug/
android/app/profile/
android/app/release/
/android/app/debug
/android/app/profile
/android/app/release
*.apk
*.aab
*.ap_
*.dex
.cxx/

# ------------------------------------------------------------------------------
# iOS & macOS Ephemeral & CocoaPods
# ------------------------------------------------------------------------------
**/ios/Flutter/.last_build_id
**/ios/Flutter/ephemeral/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Runner/GeneratedPluginRegistrant.*
**/macos/Flutter/ephemeral/
**/macos/Flutter/GeneratedPluginRegistrant.swift
**/Pods/
**/.symlinks/
*.moved-aside
*.xccheckout
*.xcscmblueprint
xcuserdata/
*.xcuserdatad

# ------------------------------------------------------------------------------
# Windows & Linux Desktop Ephemeral Build Artifacts
# ------------------------------------------------------------------------------
windows/flutter/ephemeral/
linux/flutter/ephemeral/

# ------------------------------------------------------------------------------
# IDEs & Text Editors
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/

# IntelliJ IDEA / Android Studio
.idea/
*.iml
*.ipr
*.iws
out/

# Other Editors
.atom/
.history
.svn/
.swiftpm/
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

